{
  "manifest_version": 3,
  "name": "JWT Peek",
  "version": "1.1.0",
  "description": "Surligne un JWT pour le décoder localement. Aucun appel réseau, aucun stockage.",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/jwt.js", "src/format.js", "src/selection.js", "src/card.js", "src/main.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
